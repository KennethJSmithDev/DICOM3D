# Core only: no IRIS, credentials, patient studies or host bind mounts.
FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
WORKDIR /build/viewer
COPY viewer/package.json viewer/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY viewer/ ./
COPY reference/public/ /build/reference/public/
COPY assets/ /build/assets/
RUN node node_modules/vite/bin/vite.js build --config vite.reference.config.mjs --outDir /out

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f
WORKDIR /app
COPY --from=build /out/ ./public/
COPY LICENSE NOTICE ./public/
COPY third-party/ ./public/third-party/
COPY distribution-manifest.json ./public/distribution-manifest.json
COPY docker/core/server.mjs ./server.mjs
USER node
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=6 CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.mjs"]
